# Copy to .env.local and fill in.

# PostgreSQL. Recommended: Neon (https://neon.tech, free, nothing to install).
# DATABASE_URL = Neon "Pooled connection" string, DIRECT_URL = the same string with pooling turned off.
# For a local database, set both to the same value.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Optional: Google sign-in (button appears only when both are set)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional: email verification via Resend. Without it, links are printed to the dev console.
RESEND_API_KEY=""
EMAIL_FROM="ARUVI <hello@your-domain>"

# AI companion (Claude). Create a key at https://platform.claude.com
ANTHROPIC_API_KEY=""
